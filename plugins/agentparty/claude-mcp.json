{
  "mcpServers": {
    "agentparty": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/agentparty-runtime",
      "args": [
        "mcp",
        "--all-channels"
      ]
    },
    "agentparty-channel": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/agentparty-runtime",
      "args": [
        "claude-channel",
        "--require-launch-opt-in"
      ]
    }
  }
}
